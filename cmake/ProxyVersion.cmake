get_filename_component(PROXY_VERSION_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(PROXY_VERSION_FILE "${PROXY_VERSION_ROOT}/VERSION")
file(READ "${PROXY_VERSION_FILE}" PROXY_OVER_SSH_VERSION)
string(STRIP "${PROXY_OVER_SSH_VERSION}" PROXY_OVER_SSH_VERSION)
if (NOT PROXY_OVER_SSH_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "VERSION must contain a numeric major.minor.patch version")
endif ()

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROXY_VERSION_FILE}")
set(PROXY_VERSION_INCLUDE_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated")
configure_file("${CMAKE_CURRENT_LIST_DIR}/ProxyVersion.h.in"
        "${PROXY_VERSION_INCLUDE_DIR}/ProxyVersion.h" @ONLY)
